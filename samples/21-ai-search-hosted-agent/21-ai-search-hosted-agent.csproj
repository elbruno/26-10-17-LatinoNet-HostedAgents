<!-- 21: host de retrieval autorizado.
     A. Seleccionar SDK Web e ID local. B. Fijar Foundry y Search. C. Enlazar validacion compartida. -->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>latinonet-2026-21-ai-search-hosted-agent</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.22.0-preview.260918.1" />
    <PackageReference Include="Azure.AI.Projects" Version="3.0.0-beta.2" />
    <PackageReference Include="Azure.Search.Documents" Version="11.7.0" />
    <Compile Include="..\shared\HostedSettings.cs" Link="HostedSettings.cs" />
  </ItemGroup>
</Project>
